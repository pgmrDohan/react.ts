{
  "name": "react.ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "react-router dev . --config config/vite.config.ts",
    "typegen": "react-router typegen . --config config/vite.config.ts",
    "build": "yarn typegen && tsc -p config/tsconfig.json && react-router build . --config config/vite.config.ts",
    "serve": "sirv dist/client --single __spa-fallback.html",
    "lint": "eslint --config config/eslint.config.mjs",
    "format": "prettier . --write --config config/.prettierrc --ignore-path config/.prettierignore"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "prettier"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.13.0",
  "devDependencies": {
    "@eslint/js": "10",
    "@react-router/dev": "^8.4.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react-dom": "^19.3.0",
    "sirv-cli": "^3.0.1",
    "the-new-css-reset": "^1.11.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "eslint": "10",
    "isbot": "^5",
    "react": "^19.3.0",
    "react-router": "^8.4.0",
    "sass-embedded": "^1.105.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}
